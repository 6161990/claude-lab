# Jira Cloud 연동 환경변수
# 이 파일을 복사하여 .env로 저장한 후 실제 값을 입력하세요
# .env 파일은 .gitignore에 포함되어야 합니다 (API 토큰 보안)

# Jira 연동 활성화 여부
JIRA_ENABLED=true

# Jira/Confluence 도메인 (예: https://your-company.atlassian.net)
JIRA_BASE_URL=https://your-company.atlassian.net

# Atlassian 계정 이메일
JIRA_EMAIL=your-email@example.com

# Jira API 토큰
# 발급 방법: https://id.atlassian.com/manage-profile/security/api-tokens
# 1. 위 링크 접속 → "Create API token" 클릭
# 2. 토큰 이름 입력 (예: "OneOnOne-Retrospective")
# 3. 생성된 토큰 복사
JIRA_API_TOKEN=your-api-token-here
