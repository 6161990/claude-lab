# ─────────────────────────────────────────────────────────
# Jira / Confluence 연동 (선택 사항)
# ─────────────────────────────────────────────────────────
JIRA_ENABLED=false
JIRA_BASE_URL=https://your-company.atlassian.net

# Jira API 인증용 서비스 계정 이메일 (API 호출 주체 — 웹 폼의 '분석 대상 이메일'과 다름)
# Atlassian 계정 Settings > Security > API tokens 에서 토큰 발급
JIRA_EMAIL=service-account@company.com
JIRA_API_TOKEN=your-api-token

# ─────────────────────────────────────────────────────────
# Anthropic Claude API (선택 사항 — 설정 시 AI 분석 보고서 생성)
# ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
